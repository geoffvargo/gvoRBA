}

> {%
    client.test("unknown user is 404", () => {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}

### 6. ROLE_USER books on behalf of someone else -> 403 (currently 200: userId is taken from the body, not the token)
# Uses a different hour of the same day so it can't trip the overlap constraint.
< {%
    const start = client.global.get("startsAt").replace("T10:", "T14:");
    const end = client.global.get("endsAt").replace("T11:", "T15:");
    request.variables.set("otherStartsAt", start);
    request.variables.set("otherEndsAt", end);
%}
POST {{baseUrl}}/api/bookings/add-booking
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "userId": {{adminId}},
  "roomId": {{roomId}},
  "startsAt": "{{otherStartsAt}}",
  "endsAt": "{{otherEndsAt}}",
  "purpose": "HTTP integration test (impersonation)",
  "status": "CONFIRMED"
}

> {%
    client.test("cannot book as another user", () => {
        client.assert(response.status === 403, "expected 403, got " + response.status);
    });
    // If it slipped through, remember it so 7b can clean it up.
    client.global.set("impersonatedBookingId", response.status === 200 ? response.body.id : "");
%}

### 7a. Cleanup: delete the booking from case 2
# Currently returns 500 even though the row IS deleted (the failure happens after the delete commits).
DELETE {{baseUrl}}/api/bookings/delete/{{bookingId}}
Authorization: Bearer {{userToken}}

> {%
    client.test("cleanup: case 2 booking deleted", () => {
        client.assert(response.status === 200, "expected 200, got " + response.status);
    });
%}

### 7b. Cleanup: delete the booking from case 6, if it was created (404 here means there was nothing to delete)
DELETE {{baseUrl}}/api/bookings/delete/{{impersonatedBookingId}}
Authorization: Bearer {{adminToken}}
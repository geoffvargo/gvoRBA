{
  "rules": [
    {
      "class": "m-0",
      "style": "margin: 0"
    },
    {
      "class": "my-auto",
      "style": "margin-top: auto; margin-bottom: auto"
    },
    {
      "class": "mb-3",
      "style": "margin-bottom: 12px"
    },
    {
      "class": "w-100",
      "style": "width: 400px"
    },
    {
      "class": "min-w-130",
      "style": "min-width: 520px"
    },
    {
      "class": "border-separate",
      "style": "border-collapse: separate"
    },
    {
      "class": "rounded-lg",
      "style": "border-radius: 8px"
    },
    {
      "class": "border",
      "style": "border-style: solid; border-width: 1px"
    },
    {
      "class": "p-4",
      "style": "padding: 16px"
    },
    {
      "class": "p-6",
      "style": "padding: 24px"
    },
    {
      "class": "text-right",
      "style": "text-align: right"
    },
    {
      "class": "font-sans",
      "style": "font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Noto Sans, Ubuntu, Cantarell, Helvetica Neue, sans-serif"
    }
  ],
  "extraCss": ""
}
